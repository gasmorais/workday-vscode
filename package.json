{
  "name": "proofhub",
  "displayName": "Workday",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "proofhub-vscode",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gasmorais/workday-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/gasmorais/workday-vscode/issues"
  },
  "homepage": "https://github.com/gasmorais/workday-vscode#readme",
  "keywords": [
    "proofhub",
    "microsoft-teams",
    "project-management",
    "tasks",
    "time-tracking",
    "timesheet",
    "timer",
    "chat",
    "productivity"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "proofhub",
          "title": "ProofHub",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "proofhub": [
        {
          "id": "proofhub.projects",
          "name": "%view.projects%"
        },
        {
          "id": "proofhub.teams",
          "name": "%view.teams%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "proofhub.projects",
        "contents": "%welcome.contents%"
      },
      {
        "view": "proofhub.teams",
        "contents": "%welcome.teams%"
      }
    ],
    "commands": [
      {
        "command": "proofhub.connect",
        "title": "%command.connect%",
        "icon": "$(plug)"
      },
      {
        "command": "proofhub.disconnect",
        "title": "%command.disconnect%"
      },
      {
        "command": "proofhub.refresh",
        "title": "%command.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "proofhub.openTask",
        "title": "%command.openTask%",
        "icon": "$(preview)"
      },
      {
        "command": "proofhub.createTask",
        "title": "%command.createTask%",
        "icon": "$(add)"
      },
      {
        "command": "proofhub.completeTask",
        "title": "%command.completeTask%",
        "icon": "$(check)"
      },
      {
        "command": "proofhub.comment",
        "title": "%command.comment%",
        "icon": "$(comment)"
      },
      {
        "command": "proofhub.openInBrowser",
        "title": "%command.openInBrowser%",
        "icon": "$(link-external)"
      },
      {
        "command": "proofhub.startTimer",
        "title": "%command.startTimer%",
        "icon": "$(play)"
      },
      {
        "command": "proofhub.stopTimer",
        "title": "%command.stopTimer%",
        "icon": "$(stop)"
      },
      {
        "command": "proofhub.logTime",
        "title": "%command.logTime%"
      },
      {
        "command": "proofhub.myTasks",
        "title": "%command.myTasks%"
      },
      {
        "command": "proofhub.openUrl",
        "title": "%command.openUrl%"
      },
      {
        "command": "proofhub.changeAccount",
        "title": "%command.changeAccount%"
      },
      {
        "command": "proofhub.moveToRight",
        "title": "%command.moveToRight%"
      },
      {
        "command": "proofhub.report",
        "title": "%command.report%",
        "icon": "$(graph)"
      },
      {
        "command": "proofhub.search",
        "title": "%command.search%",
        "icon": "$(search)"
      },
      {
        "command": "proofhub.filter",
        "title": "%command.filter%",
        "icon": "$(filter)"
      },
      {
        "command": "proofhub.clearFilter",
        "title": "%command.clearFilter%",
        "icon": "$(filter-filled)"
      },
      {
        "command": "proofhub.sort",
        "title": "%command.sort%",
        "icon": "$(list-ordered)"
      },
      {
        "command": "proofhub.filterByPerson",
        "title": "%command.filterByPerson%",
        "icon": "$(organization)"
      },
      {
        "command": "proofhub.teams.connect",
        "title": "%command.teams.connect%",
        "icon": "$(plug)"
      },
      {
        "command": "proofhub.teams.disconnect",
        "title": "%command.teams.disconnect%"
      },
      {
        "command": "proofhub.teams.refresh",
        "title": "%command.teams.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "proofhub.teams.openChat",
        "title": "%command.teams.openChat%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "proofhub.teams.toggleFavorite",
        "title": "%command.teams.toggleFavorite%",
        "icon": "$(star)"
      },
      {
        "command": "proofhub.teams.joinMeeting",
        "title": "%command.teams.joinMeeting%",
        "icon": "$(device-camera-video)"
      },
      {
        "command": "proofhub.teams.logCall",
        "title": "%command.teams.logCall%",
        "icon": "$(watch)"
      },
      {
        "command": "proofhub.teams.watchCalls",
        "title": "%command.teams.watchCalls%",
        "category": "Workday",
        "icon": "$(device-camera-video)"
      },
      {
        "command": "proofhub.teams.stopCalls",
        "title": "%command.teams.stopCalls%",
        "category": "Workday"
      },
      {
        "command": "proofhub.teams.diagnoseCalls",
        "title": "%command.teams.diagnoseCalls%",
        "category": "Workday"
      },
      {
        "command": "proofhub.teams.discardCall",
        "title": "%command.teams.discardCall%",
        "category": "Workday",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "proofhub.createTask",
          "when": "view == proofhub.projects",
          "group": "navigation@1"
        },
        {
          "command": "proofhub.search",
          "when": "view == proofhub.projects",
          "group": "navigation@2"
        },
        {
          "command": "proofhub.filter",
          "when": "view == proofhub.projects && !proofhub.filtering",
          "group": "navigation@3"
        },
        {
          "command": "proofhub.clearFilter",
          "when": "view == proofhub.projects && proofhub.filtering",
          "group": "navigation@3"
        },
        {
          "command": "proofhub.report",
          "when": "view == proofhub.projects",
          "group": "navigation@4"
        },
        {
          "command": "proofhub.refresh",
          "when": "view == proofhub.projects",
          "group": "navigation@5"
        },
        {
          "command": "proofhub.sort",
          "when": "view == proofhub.projects",
          "group": "1_view"
        },
        {
          "command": "proofhub.myTasks",
          "when": "view == proofhub.projects",
          "group": "1_view"
        },
        {
          "command": "proofhub.moveToRight",
          "when": "view == proofhub.projects",
          "group": "9_layout"
        },
        {
          "command": "proofhub.filterByPerson",
          "when": "view == proofhub.projects",
          "group": "1_view"
        },
        {
          "command": "proofhub.teams.refresh",
          "when": "view == proofhub.teams",
          "group": "navigation@1"
        },
        {
          "command": "proofhub.teams.disconnect",
          "when": "view == proofhub.teams && proofhub.teamsConnected",
          "group": "9_layout"
        },
        {
          "command": "proofhub.teams.watchCalls",
          "when": "view == proofhub.teams && !proofhub.callsWatched",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "proofhub.openTask",
          "when": "view == proofhub.projects && viewItem == task",
          "group": "1_actions@0"
        },
        {
          "command": "proofhub.completeTask",
          "when": "view == proofhub.projects && viewItem == task",
          "group": "inline@1"
        },
        {
          "command": "proofhub.startTimer",
          "when": "view == proofhub.projects && viewItem == task",
          "group": "inline@2"
        },
        {
          "command": "proofhub.comment",
          "when": "view == proofhub.projects && viewItem == task",
          "group": "1_actions"
        },
        {
          "command": "proofhub.logTime",
          "when": "view == proofhub.projects && viewItem == task",
          "group": "1_actions"
        },
        {
          "command": "proofhub.openInBrowser",
          "when": "view == proofhub.projects",
          "group": "2_open"
        },
        {
          "command": "proofhub.teams.toggleFavorite",
          "when": "view == proofhub.teams && viewItem =~ /^teamsChat/",
          "group": "inline@1"
        },
        {
          "command": "proofhub.teams.joinMeeting",
          "when": "view == proofhub.teams && viewItem == teamsMeetingJoin",
          "group": "inline@1"
        },
        {
          "command": "proofhub.teams.logCall",
          "when": "view == proofhub.teams && viewItem == teamsCallPending",
          "group": "inline@1"
        },
        {
          "command": "proofhub.teams.discardCall",
          "when": "view == proofhub.teams && viewItem == teamsCallPending",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "ProofHub",
      "properties": {
        "proofhub.account": {
          "type": "string",
          "default": "",
          "description": "%config.account%"
        },
        "proofhub.contactEmail": {
          "type": "string",
          "default": "",
          "description": "%config.contactEmail%"
        },
        "proofhub.archivedProjects": {
          "type": "boolean",
          "default": false,
          "description": "%config.archivedProjects%"
        },
        "proofhub.apiPagePath": {
          "type": "string",
          "default": "bapplite/#app/me/api",
          "description": "%config.apiPagePath%"
        },
        "proofhub.openOnRight": {
          "type": "boolean",
          "default": true,
          "description": "%config.openOnRight%"
        },
        "proofhub.syncOnFocus": {
          "type": "boolean",
          "default": true,
          "description": "%config.syncOnFocus%"
        },
        "proofhub.dailyGoal": {
          "type": "string",
          "default": "8:00",
          "description": "%config.dailyGoal%"
        },
        "proofhub.cacheSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "description": "%config.cacheSeconds%"
        },
        "proofhub.autoRefreshMinutes": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%config.autoRefreshMinutes%"
        },
        "proofhub.teams.clientId": {
          "type": "string",
          "default": "",
          "description": "%config.teams.clientId%"
        },
        "proofhub.teams.tenantId": {
          "type": "string",
          "default": "",
          "description": "%config.teams.tenantId%"
        },
        "proofhub.teams.localPort": {
          "type": "number",
          "default": 8124,
          "description": "%config.teams.localPort%"
        },
        "proofhub.teams.roundMinutes": {
          "type": "number",
          "default": 5,
          "description": "%config.teams.roundMinutes%"
        },
        "proofhub.teams.macPollSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 2,
          "markdownDescription": "%config.teams.macPollSeconds%"
        },
        "proofhub.teams.callWindowPattern": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.teams.callWindowPattern%"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "test": "npm run build --silent && node --test test/*.test.mjs",
    "check": "prettier --check . && tsc --noEmit -p tsconfig.json && npm test --silent",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.9.2",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "The extension only talks to the ProofHub API and never runs workspace code."
    },
    "virtualWorkspaces": true
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
