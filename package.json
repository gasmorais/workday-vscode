{
  "name": "proofhub",
  "displayName": "ProofHub",
  "description": "Veja e atualize projetos, tarefas, comentários e horas do ProofHub sem sair do editor.",
  "version": "0.1.0",
  "publisher": "proofhub-vscode",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "proofhub",
          "title": "ProofHub",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "proofhub": [
        {
          "id": "proofhub.projects",
          "name": "Projetos"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "proofhub.projects",
        "contents": "Conecte no ProofHub para ver seus projetos e tarefas aqui.\n[Conectar no ProofHub](command:proofhub.connect)\n\nA chave é pessoal, validada na conexão e guardada no cofre de segredos do VS Code, só nesta máquina."
      }
    ],
    "commands": [
      {
        "command": "proofhub.connect",
        "title": "ProofHub: Conectar",
        "icon": "$(plug)"
      },
      {
        "command": "proofhub.disconnect",
        "title": "ProofHub: Desconectar"
      },
      {
        "command": "proofhub.refresh",
        "title": "ProofHub: Atualizar",
        "icon": "$(refresh)"
      },
      {
        "command": "proofhub.openTask",
        "title": "ProofHub: Abrir tarefa",
        "icon": "$(preview)"
      },
      {
        "command": "proofhub.createTask",
        "title": "ProofHub: Nova tarefa",
        "icon": "$(add)"
      },
      {
        "command": "proofhub.completeTask",
        "title": "ProofHub: Concluir tarefa",
        "icon": "$(check)"
      },
      {
        "command": "proofhub.comment",
        "title": "ProofHub: Comentar",
        "icon": "$(comment)"
      },
      {
        "command": "proofhub.openInBrowser",
        "title": "ProofHub: Abrir no navegador",
        "icon": "$(link-external)"
      },
      {
        "command": "proofhub.startTimer",
        "title": "ProofHub: Iniciar cronômetro",
        "icon": "$(play)"
      },
      {
        "command": "proofhub.stopTimer",
        "title": "ProofHub: Parar cronômetro e lançar horas",
        "icon": "$(stop)"
      },
      {
        "command": "proofhub.logTime",
        "title": "ProofHub: Lançar horas"
      },
      {
        "command": "proofhub.myTasks",
        "title": "ProofHub: Minhas tarefas"
      },
      {
        "command": "proofhub.openUrl",
        "title": "ProofHub: Abrir link"
      },
      {
        "command": "proofhub.changeAccount",
        "title": "ProofHub: Trocar de conta"
      },
      {
        "command": "proofhub.moveToRight",
        "title": "ProofHub: Mover painel para a barra da direita"
      },
      {
        "command": "proofhub.report",
        "title": "ProofHub: Horas e gráficos",
        "icon": "$(graph)"
      },
      {
        "command": "proofhub.search",
        "title": "ProofHub: Buscar tarefas",
        "icon": "$(search)"
      },
      {
        "command": "proofhub.filter",
        "title": "ProofHub: Filtrar tarefas",
        "icon": "$(filter)"
      },
      {
        "command": "proofhub.clearFilter",
        "title": "ProofHub: Limpar filtros",
        "icon": "$(filter-filled)"
      },
      {
        "command": "proofhub.sort",
        "title": "ProofHub: Ordenar tarefas",
        "icon": "$(list-ordered)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "proofhub.createTask",
          "when": "view == proofhub.projects",
          "group": "navigation@1"
        },
        {
          "command": "proofhub.search",
          "when": "view == proofhub.projects",
          "group": "navigation@2"
        },
        {
          "command": "proofhub.filter",
          "when": "view == proofhub.projects && !proofhub.filtering",
          "group": "navigation@3"
        },
        {
          "command": "proofhub.clearFilter",
          "when": "view == proofhub.projects && proofhub.filtering",
          "group": "navigation@3"
        },
        {
          "command": "proofhub.report",
          "when": "view == proofhub.projects",
          "group": "navigation@4"
        },
        {
          "command": "proofhub.refresh",
          "when": "view == proofhub.projects",
          "group": "navigation@5"
        },
        {
          "command": "proofhub.sort",
          "when": "view == proofhub.projects",
          "group": "1_view"
        },
        {
          "command": "proofhub.myTasks",
          "when": "view == proofhub.projects",
          "group": "1_view"
        },
        {
          "command": "proofhub.moveToRight",
          "when": "view == proofhub.projects",
          "group": "9_layout"
        }
      ],
      "view/item/context": [
        {
          "command": "proofhub.openTask",
          "when": "view == proofhub.projects && viewItem == task",
          "group": "1_actions@0"
        },
        {
          "command": "proofhub.completeTask",
          "when": "view == proofhub.projects && viewItem == task",
          "group": "inline@1"
        },
        {
          "command": "proofhub.startTimer",
          "when": "view == proofhub.projects && viewItem == task",
          "group": "inline@2"
        },
        {
          "command": "proofhub.comment",
          "when": "view == proofhub.projects && viewItem == task",
          "group": "1_actions"
        },
        {
          "command": "proofhub.logTime",
          "when": "view == proofhub.projects && viewItem == task",
          "group": "1_actions"
        },
        {
          "command": "proofhub.openInBrowser",
          "when": "view == proofhub.projects",
          "group": "2_open"
        }
      ]
    },
    "configuration": {
      "title": "ProofHub",
      "properties": {
        "proofhub.account": {
          "type": "string",
          "default": "acme.proofhub.com",
          "description": "Endereço da conta do ProofHub. Já vem apontado para a conta da sua empresa."
        },
        "proofhub.contactEmail": {
          "type": "string",
          "default": "",
          "description": "E-mail de contato enviado no cabeçalho User-Agent, exigido pela API do ProofHub."
        },
        "proofhub.archivedProjects": {
          "type": "boolean",
          "default": false,
          "description": "Incluir projetos arquivados na árvore."
        },
        "proofhub.apiPagePath": {
          "type": "string",
          "default": "bapplite/#app/me/api",
          "description": "Caminho da página de acesso à API, aberta pelo comando Conectar. Ajuste se o ProofHub mudar o endereço."
        },
        "proofhub.openOnRight": {
          "type": "boolean",
          "default": true,
          "description": "Mover o painel do ProofHub para a barra lateral direita na primeira vez que ele abre."
        },
        "proofhub.syncOnFocus": {
          "type": "boolean",
          "default": true,
          "description": "Recarregar projetos e a tarefa aberta sempre que a janela do VS Code voltar ao foco."
        },
        "proofhub.dailyGoal": {
          "type": "string",
          "default": "8:00",
          "description": "Meta diária de horas, no formato H:MM. Vira a linha de referência do gráfico de dias."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "test": "npm run build --silent && node --test test/*.test.mjs",
    "check": "tsc --noEmit -p tsconfig.json && npm test --silent"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.6.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "The extension only talks to the ProofHub API and never runs workspace code."
    },
    "virtualWorkspaces": true
  }
}
