{
  "name": "proofhub",
  "displayName": "ProofHub",
  "description": "Browse and update ProofHub projects, tasks, comments and time without leaving the editor.",
  "version": "0.1.0",
  "publisher": "proofhub-vscode",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "proofhub",
          "title": "ProofHub",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "proofhub": [
        {
          "id": "proofhub.projects",
          "name": "Projects"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "proofhub.projects",
        "contents": "Connect to your ProofHub account to see projects and tasks here.\n[Connect to ProofHub](command:proofhub.connect)\n\nThe key is personal and stays in the VS Code secret storage on this machine."
      }
    ],
    "commands": [
      {
        "command": "proofhub.connect",
        "title": "ProofHub: Connect",
        "icon": "$(plug)"
      },
      {
        "command": "proofhub.disconnect",
        "title": "ProofHub: Disconnect"
      },
      {
        "command": "proofhub.refresh",
        "title": "ProofHub: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "proofhub.createTask",
        "title": "ProofHub: New Task",
        "icon": "$(add)"
      },
      {
        "command": "proofhub.completeTask",
        "title": "ProofHub: Complete Task",
        "icon": "$(check)"
      },
      {
        "command": "proofhub.comment",
        "title": "ProofHub: Add Comment",
        "icon": "$(comment)"
      },
      {
        "command": "proofhub.openInBrowser",
        "title": "ProofHub: Open in Browser",
        "icon": "$(link-external)"
      },
      {
        "command": "proofhub.startTimer",
        "title": "ProofHub: Start Timer",
        "icon": "$(play)"
      },
      {
        "command": "proofhub.stopTimer",
        "title": "ProofHub: Stop Timer and Log Time",
        "icon": "$(stop)"
      },
      {
        "command": "proofhub.logTime",
        "title": "ProofHub: Log Time"
      },
      {
        "command": "proofhub.myTasks",
        "title": "ProofHub: My Tasks"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "proofhub.createTask",
          "when": "view == proofhub.projects",
          "group": "navigation@1"
        },
        {
          "command": "proofhub.refresh",
          "when": "view == proofhub.projects",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "proofhub.completeTask",
          "when": "view == proofhub.projects && viewItem == task",
          "group": "inline@1"
        },
        {
          "command": "proofhub.startTimer",
          "when": "view == proofhub.projects && viewItem == task",
          "group": "inline@2"
        },
        {
          "command": "proofhub.comment",
          "when": "view == proofhub.projects && viewItem == task",
          "group": "1_actions"
        },
        {
          "command": "proofhub.logTime",
          "when": "view == proofhub.projects && viewItem == task",
          "group": "1_actions"
        },
        {
          "command": "proofhub.openInBrowser",
          "when": "view == proofhub.projects",
          "group": "2_open"
        }
      ]
    },
    "configuration": {
      "title": "ProofHub",
      "properties": {
        "proofhub.account": {
          "type": "string",
          "default": "",
          "description": "Your ProofHub account host, for example acme.proofhub.com."
        },
        "proofhub.contactEmail": {
          "type": "string",
          "default": "",
          "description": "Contact email sent in the User-Agent header, required by the ProofHub API."
        },
        "proofhub.archivedProjects": {
          "type": "boolean",
          "default": false,
          "description": "Include archived projects in the tree."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "test": "npm run build --silent && node --test test/*.test.mjs",
    "check": "tsc --noEmit -p tsconfig.json && npm test --silent"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.6.0"
  }
}
